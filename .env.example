# vgx-taskco — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Fastify server listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://vgxtaskco:vgxtaskco_dev@localhost:5432/vgxtaskco

# ── Auth ───────────────────────────────────────────────────────────────────────
# JWT signing secret — MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# HMAC-SHA256 pepper for API token hashing — MUST be at least 32 characters.
# Different from JWT_SECRET. Generate the same way.
API_TOKEN_PEPPER=change-me-to-another-random-string-at-least-32-chars

# ── SSO (optional) ─────────────────────────────────────────────────────────────
# Supabase project URL and service-role key for OAuth token verification.
# Leave blank to disable SSO — local email/password auth continues to work.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development defaults to http://localhost:5173 (Vite default).
# Required in production.
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173
